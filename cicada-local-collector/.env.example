# CICADA Local Collector — Environment Configuration Template
# Copy this file to .env and configure with your Supabase project credentials.
# NEVER commit your actual .env file or credentials to version control.

# Supabase Project HTTPS URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable Key (safe for public clients)
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Device Authentication Token (JWT obtained during device enrollment)
# If left empty, the collector runs in local-only mode.
SUPABASE_DEVICE_TOKEN=your-device-enrollment-jwt-here

# CICADA Tenant UUID (Shared across your organization's laptops)
CICADA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Telemetry Collection Interval in Seconds (Default: 10s for hackathon demo)
COLLECTION_INTERVAL_SECONDS=10

# Ping probe target for network latency diagnostics (Default: 1.1.1.1)
PROBE_TARGET=1.1.1.1
