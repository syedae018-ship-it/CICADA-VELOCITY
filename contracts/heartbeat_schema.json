{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heartbeat v1.0 — sent every 10 s by each collector, even when there is no telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["collector_id", "tenant_id", "region", "sent_at_utc", "version", "buffer_depth", "config_hash"],
  "properties": {
    "collector_id": { "type": "string", "pattern": "^c_[a-z0-9]{2,16}$" },
    "tenant_id": { "type": "string", "pattern": "^t_[a-z0-9]{2,16}$" },
    "region": { "enum": ["ap-south-1", "eu-west-1", "us-east-1"] },
    "sent_at_utc": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "maxLength": 20 },
    "buffer_depth": { "type": "integer", "minimum": 0 },
    "config_hash": { "type": "string", "pattern": "^[a-f0-9]{8,64}$" }
  }
}
