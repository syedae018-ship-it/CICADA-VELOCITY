# Copy to .env and adjust. NEVER commit .env.
# --- Collector (Tier 1) ---
COLLECTOR_ID=c_blr01
TENANT_ID=t_acme
REGION=ap-south-1
SOURCE_TZ=Asia/Kolkata
SAAS_URL=http://localhost:8000
COLLECTOR_SECRET=dev-secret-c_blr01
SITE_SALT=change-me-local-only
LOCAL_RETENTION_HOURS=24
DEV_INSECURE=1
# --- SaaS (Tier 2) ---
# Supabase: Project Settings → API. SERVICE ROLE KEY IS SERVER-ONLY: never in dashboard/, never committed.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SUPABASE_JWT_SECRET=<jwt-secret>
DASHBOARD_ORIGIN=http://localhost:3000
# --- Dashboard ---
NEXT_PUBLIC_SAAS_URL=http://localhost:8000
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
