# Copy to .env and adjust. NEVER commit .env.
# --- Collector (Tier 1) ---
COLLECTOR_ID=c_blr01
TENANT_ID=t_acme
REGION=ap-south-1
SOURCE_TZ=Asia/Kolkata
SAAS_URL=http://localhost:8000
COLLECTOR_SECRET=dev-secret-c_blr01
SITE_SALT=change-me-local-only
LOCAL_RETENTION_HOURS=24
DEV_INSECURE=1
# Live demo controls on the collector (/local/demo/*): turn off in production
DEMO_CONTROLS=1
DEMO_TRAFFIC=1
# --- SaaS (Tier 2) ---
# Supabase (Project Settings → Data API / API Keys). Leave empty to use local SQLite instead.
# The secret / service-role key is SERVER-ONLY: never in dashboard/, never committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DASHBOARD_ORIGIN=http://localhost:3000
# --- Dashboard ---
NEXT_PUBLIC_SAAS_URL=http://localhost:8000
NEXT_PUBLIC_COLLECTOR_URL=http://localhost:8001
# one collector per tenant environment
NEXT_PUBLIC_COLLECTOR_URLS=t_acme=http://localhost:8001,t_globex=http://localhost:8002
# Publishable / anon key only (RLS protects the data). Empty = dashboard runs in demo-token mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
